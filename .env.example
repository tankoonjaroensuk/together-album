# Copy to .env for local development, and add the same names under Vercel > Settings > Environment Variables.
# All three values are on the Cloudinary dashboard (Settings > API Keys).
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NUXT_CLOUDINARY_API_KEY=
NUXT_CLOUDINARY_API_SECRET=

# Where guest photos are stored. Use a different folder per environment, e.g. together-album/production on Vercel.
NUXT_CLOUDINARY_FOLDER=together-album/dev

# Set to false after the event to stop accepting photos (redeploy on Vercel for it to apply).
NUXT_UPLOADS_ENABLED=true
